<Application>
  <ActionDesign>
    <Actions>
      <Action Id="ChangePasswordByUser" Caption="Mein Passwort ändern" />
      <Action Id="DeletePermissionDescriptor" Caption="Löschen" ConfirmationMessage="Sie sind dabei, das ausgewählte Element (e) zu löschen. Wollen Sie fortfahren?" />
      <Action Id="Deny_TypePermissionMatrixItem" Caption="Verbieten">
        <ChoiceActionItems>
          <ChoiceActionItem Id="Create" Caption="Erzeugen" />
          <ChoiceActionItem Id="Delete" Caption="Löschen" />
          <ChoiceActionItem Id="Deny All" Caption="Alles Verbieten" />
          <ChoiceActionItem Id="Deny Modification" Caption="Änderung Verbieten" />
          <ChoiceActionItem Id="Navigate" Caption="Navigieren" />
          <ChoiceActionItem Id="Read" Caption="Lesen" />
          <ChoiceActionItem Id="Write" Caption="Schreiben" />
        </ChoiceActionItems>
      </Action>
      <Action Id="Grant_TypePermissionMatrixItem" Caption="Erlauben">
