          <ChoiceActionItem Id="Create" Caption="Erzeugen" />
          <ChoiceActionItem Id="Delete" Caption="Löschen" />
          <ChoiceActionItem Id="Full Access" Caption="Voller Zugriff" />
          <ChoiceActionItem Id="Navigate" Caption="Navigieren" />
          <ChoiceActionItem Id="Read" Caption="Lesen" />
          <ChoiceActionItem Id="Read Only Access" Caption="Nur Lesezugriff" />
          <ChoiceActionItem Id="Write" Caption="Schreiben" />
        </ChoiceActionItems>
      </Action>
      <Action Id="MyDetails" Caption="Meine Details" />
      <Action Id="NewPermissionDescriptor" Caption="Neu" />
      <Action Id="ResetPassword" Caption="Passwort Zurücksetzen" ToolTip="Das Password des ausgewählten Benutzers zurücksetzen" />
    </Actions>
  </ActionDesign>
