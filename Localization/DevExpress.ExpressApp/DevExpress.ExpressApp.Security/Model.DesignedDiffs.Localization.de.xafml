  <Views>
    <DetailView Id="AuthenticationStandardLogonParameters_DetailView" Caption="Anmeldung">
      <Items>
        <StaticText Id="LogonText" Text="Willkommen! Bitte geben Sie Ihren Benutzernamen und Ihr Passwort ein." />
      </Items>
    </DetailView>
    <DetailView Id="ChangePasswordOnLogonParameters_DetailView" Caption="Passwort ändern bei der ersten Anmeldung">
      <Items>
        <StaticText Id="ChangePasswordText" Text="Aus Sicherheitsgründen müssen Sie jetzt Ihr eigenes Passwort setzen. Bitte geben Sie Ihr neues Passwort in die beiden Textfelder unten ein, und stellen Sie sicher, dass Sie nicht ein Passwort verwenden, welches Sie bereits zuvor verwendet haben." />
      </Items>
    </DetailView>
    <DetailView Id="ChangePasswordParameters_DetailView" Caption="Passwort ändern">
      <Items>
        <StaticText Id="ChangePasswordText" Text="Um das Passwort zu ändern, geben Sie bitte Ihr altes und neues Passwort in die Textfelder unten ein." />
      </Items>
    </DetailView>
    <DetailView Id="ObjectAccessPermission_DetailView">
      <Layout>
        <LayoutGroup Id="Main">
          <LayoutGroup Id="SimpleEditors">
            <LayoutGroup Id="ObjectAccessPermission" Caption="Berechtigung für den Objektzugriff" />
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
    <DetailView Id="ResetPasswordParameters_DetailView" Caption="Passwort zurücksetzen">
      <Items>
        <StaticText Id="ResetPasswordText" Text="Durch Zurücksetzen des Passworts wird automatisch ein neues Passwort erstellt, gleichzeitig wird die Anmeldung mit dem alten Passwort deaktiviert. Sie müssen das neue Passwort an die Benutzerin weiterleiten, so dass diese weiterhin mit der Applikation arbeiten kann. Sind Sie sicher, dass Sie fortfahren möchten?" />
      </Items>
    </DetailView>
    <ListView Id="SecurityStrategyRole_LookupListView" Caption="Rolle" />
    <ListView Id="SecurityUserBase_LookupListView" Caption="Benutzer" />
    <ListView Id="SecurityUserWithRolesBase_LookupListView" Caption="Benutzer" />
  </Views>
</Application>