      </OwnMembers>
    </Class>
  </BOModel>
  <ActionDesign>
    <Actions>
      <Action Id="RefreshNotifications" Caption="Обновить" ShortCaption="Обновить" ToolTip="Обновить" />
      <Action Id="Snooze" Caption="Отложить" ShortCaption="Отложить" ToolTip="Отложить" />
      <Action Id="Dismiss" Caption="Отменить" ShortCaption="Отменить" ToolTip="Отменить" />
      <Action Id="DismissAll" Caption="Отменить все" ShortCaption="Отменить все" ToolTip="Отменить все" />
