<?xml version="1.0" encoding="utf-8"?>
<Application>
  <BOModel>
    <Class Name="DevExpress.ExpressApp.Notifications.NotificationsObject" ObjectCaptionFormat="Напоминаний: {0:NotificationsCount}">
      <OwnMembers>
        <Member Name="NotificationsState" Caption="Тип напоминаний" />
        <Member Name="Notifications" Caption="Напоминания" />
        <Member Name="Postpone" Caption="Отложить на" />
        <Member Name="ShowNotificationsWindow" Caption="Показыывать окно с напоминаниями" />
