      <OwnMembers>
        <Member Name="NotificationSource" Caption="Событие" />
      </OwnMembers>
    </Class>
    <Class Name="DevExpress.ExpressApp.SystemModule.Notifications.PostponeTime" Caption="Промежуток времени">
      <OwnMembers>
        <Member Name="ID" Caption="Идентификатор"/>
        <Member Name="RemindInText" Caption="Промежуток времени" />
        <Member Name="RemindIn" Caption="Промежуток времени" />
      </OwnMembers>
    </Class>
    <Class Name="DevExpress.ExpressApp.Notifications.Notification" Caption="Напоминание">
      <OwnMembers>
        <Member Name="ID" Caption="Идентификатор"/>
