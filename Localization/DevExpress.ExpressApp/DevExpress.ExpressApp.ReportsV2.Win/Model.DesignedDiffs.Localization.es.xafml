<?xml version="1.0" encoding="utf-8"?>
<Application>
  <ActionDesign>
    <Actions>
      <Action Id="EditReportControllerV2.Edit" Caption="Editar" />
      <Action Id="ExecuteReportV2" Caption="Ejecutar informe" />
      <Action Id="ShowReportDesignerV2" Caption="Mostrar el Diseñador de informes" />
    </Actions>
  </ActionDesign>
  <Localization>
    <LocalizationGroup Name="Captions">
      <LocalizationItem Name="AllFiles" Value="Todos los archivos" />
      <LocalizationItem Name="ExportLayout" Value="diseño Exportar a archivo ..." />
      <LocalizationItem Name="ImportLayout" Value="Importar desde un archivo de diseño ..." />
      <LocalizationItem Name="ReportDesignerWarning" Value="Advertencia" />
      <LocalizationItem Name="ReportFiles" Value="Informe de Archivos" />
      <LocalizationItem Name="ReportDesignerError" Value="Error" />
    </LocalizationGroup>
  </Localization>
  <Views>
    <DetailView Id="NewReportWizardParameters_DetailView" Caption="Nuevo Asistente para informes">
      <Items>
        <StaticText Id="ReportText" Text="Para crear un nuevo informe, por favor, introduzca un nombre en el campo de abajo y seleccione el tipo de datos principal del informe de la lista." />
      </Items>
      <Layout>
        <LayoutGroup Id="Main" Caption="Principales">
          <LayoutGroup Id="Static" Caption="Estática (11)">
            <LayoutGroup Id="NewReportParams" Caption="Nuevos Parámetros Informe">
              <LayoutGroup Id="SimpleEditors" Caption="Editores simple" />
            </LayoutGroup>
          </LayoutGroup>
        </LayoutGroup>
      </Layout>
    </DetailView>
  </Views>
</Application>