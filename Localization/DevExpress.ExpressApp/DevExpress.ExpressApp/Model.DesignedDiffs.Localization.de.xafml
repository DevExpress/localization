    <DetailView Id="ProcessDataLockingInfoMergeDialog_DetailView" Caption="Warnung">
      <Items>
        <StaticText Id="Message" Text="Die Daten, die Sie speichern möchten, sind von einem anderen Benutzer geändert worden. Sie können entweder die Änderungen zusammenführen, Ihre Änderungen verwerfen und die Daten lokal aktualisieren oder die Speicheroperation abbrechen." />
      </Items>
    </DetailView>
    <DetailView Id="ProcessDataLockingInfoRefreshDialog_DetailView" Caption="Warnung">
      <Items>
        <StaticText Id="Message" Text="Die Daten, die Sie speichern möchten, sind von einem anderen Benutzer geändert worden. Sie können entweder Ihre Änderungen verwerfen und die Daten lokal aktualisieren oder die Speicheroperation abbrechen." />
      </Items>
    </DetailView>
