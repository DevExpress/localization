<?xml version="1.0" encoding="utf-8"?>
<Application ProtectedContentText="Geschützter Inhalt">
  <ActionDesign>
    <Actions>
      <Action Id="MergeAction" Caption="Zusammenführen" ShortCaption="Zusammenführen" ToolTip="Zusammenführen" />
      <Action Id="CancelAction" Caption="Abbrechen" ToolTip="Abbrechen" ShortCaption="Abbrechen" />
      <Action Id="RefreshAction" Caption="Aktualisieren" ToolTip="Aktualisieren" ShortCaption="Aktualisieren" />
      <Action Id="CreateModelDifferences" Caption="Modelldifferenzen erzeugen" ToolTip="Initialisiert Einstellungen (Modeldifferenzen) für alle Benutzer." />
      <Action Id="CopyModelDifference" Caption="Modelldifferenz kopieren" ToolTip="Kopiert Einstellungen (Modelldifferenzen) von einem Benutzer zu einem anderen. Wählen Sie die Quelleinstellungen (Modelldifferenzen) aus, klicken Sie diesen Schalter und wählen Sie Ziele in dem Dialog aus. Änderungen werden aktiviert, wenn ein Benutzer die Anwendung neu startet." />
      <Action Id="ExportModelDifferences" Caption="Modelldifferenzen exportieren" ToolTip="Exportiert ausgewählte Einstellungen (Modeldifferenzen) in den Ordner {0}." />
      <Action Id="ImportSharedModelDifference" Caption="Gemeinsame Modelldifferenzen importieren" ConfirmationMessage="Gemeinsame Einstellungen (Modelldifferenzen) werden mit dem Inhalt der Datei {0} überschrieben. Dies kann nicht rückgängig gemacht werden. Möchten Sie fortfahren?" ToolTip="Importiert gemeinsame Einstellungen (Modelldifferenzen) aus der Datei {0} im Anwendungsverzeichnis." />      
      <Action Id="ResetModelDifferences" Caption="Modelldifferenzen zurücksetzen" ToolTip="Setzt ausgewählte Einstellungen (Modelldifferenzen) zurück. Änderungen werden angewandt, wenn ein Benutzer die Anwendung neu startet." ConfirmationMessage="Ausgewählte Einstellungen (Modelldifferenzen) werden zurückgesetzt. Möchten Sie fortfahren?" />
      <Action Id="ResetViewSettings" Caption="Ansichtseinstellungen zurücksetzen" ToolTip="Setzt alle Einstellungen für die Ansicht '{0}' zurück." ConfirmationMessage="Alle Einstellungen für die Ansicht '{0}' werden zurückgesetzt. Möchten Sie fortfahren?" />
      
      <Action Id="About Info" Caption="Über..." />
      <Action Id="Cancel" Caption="Abbrechen" />
      <Action Id="CreateDashboard" Caption="Erzeuge Übersicht" />
      <Action Id="Delete" Caption="Löschen" ConfirmationMessage="Sie sind im Begriff die selektierten Datensätze zu löschen. Möchten Sie fortfahren?" />
      <Action Id="Delete Item" Caption="Datensatz löschen" ConfirmationMessage="Sie sind im Begriff die selektierten Datensätze zu löschen. Möchten Sie fortsetzen?" />
      <Action Id="Diagnostic Info" Caption="Diagnose" />
      <Action Id="Diagnostic Info.Actions Info">
        <ChoiceActionItems>
          <ChoiceActionItem Id="Actions Info" Caption="Aktions Info" />
        </ChoiceActionItems>
      </Action>
      <Action Id="Diagnostic Info.View Info">
        <ChoiceActionItems>
          <ChoiceActionItem Id="View Info" Caption="Ansicht Info" />
        </ChoiceActionItems>
      </Action>
      <Action Id="DialogCancel" Caption="Abbrechen" />
      <Action Id="DialogClose" Caption="Schließen" ToolTip="Schließen" ShortCaption="Schließen"/>
      <Action Id="FullTextSearch" NullValuePrompt="Suchtext..." Caption="Filtern nach Text" ToolTip="Datensätze filtern nach Text" ShortCaption="Ausführen!" />
      <Action Id="HideItemsFromDashboard" Caption="Aus Übersicht ausblenden" ToolTip="Ausgewählten Artikel aus Übersicht ausblenden" />
      <Action Id="Link" Caption="Verbinden" />
      <Action Id="ListViewShowObject" Caption="Öffnen" />
      <Action Id="Logoff" Caption="Abmelden" />
      <Action Id="Logon" Caption="Anmelden" />
      <Action Id="NavigateBack" ToolTip="Navigieren zur vorherigen Ansicht" Caption="Zurück" />
      <Action Id="NavigateForward" ToolTip="Navigieren zur nächsten Ansicht" Caption="Vorwärts" />
      <Action Id="New" Caption="Neu">
        <DisableReasons>
          <Reason Id="MasterObjectIsNew" Caption="Der editierte Datensatz ist neu." />
        </DisableReasons>
      </Action>
      <Action Id="NextObject" Caption="Nächster Datensatz" />
      <Action Id="OrganizeDashboard" Caption="Organisiere Übersicht" />
      <Action Id="DeleteDashboard" Caption="Dashboard löschen" />
      <Action Id="PreviousObject" Caption="Vorheriger Datensatz" />
      <Action Id="Refresh" Caption="Aktualisieren" />
      <Action Id="Save" Caption="Speichern" />
      <Action Id="SaveAndClose" Caption="Speichern und Schließen" />
      <Action Id="SaveAndNew" Caption="Speichern und Neu" />
      <Action Id="SetFilter" Caption="Filtern" />
      <Action Id="ShowItemsOnDashboard" Caption="Zeige in Übersicht" ToolTip="Zeige ausgewählten Artikel in Übersicht" />
      <Action Id="Unlink" Caption="Trennen" ConfirmationMessage="Sie sind im Begriff die selektierten Datensätze zu trennen. Möchten Sie fortfahren?" />
    </Actions>
    <DisableReasons>
      <Reason Id="ByContext_RequireMultipleObjects" Caption="Benötigt mindestens einen selektierten Datensatz" />
      <Reason Id="ByContext_RequireSingleObject" Caption="Benötigt einen einzelnen selektierten Datensatz" />
      <Reason Id="Security" Caption="Berechtigung verweigert" />
    </DisableReasons>
