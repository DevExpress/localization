  <Views>
    <DetailView Id="AboutInfo_DetailView" Caption="アプリケーションについて">
      <Items>
        <StaticText Id="AboutText" Text="{0:ProductName}&lt;br&gt;{0:Version}&lt;br&gt;&lt;br&gt;{0:Copyright}&lt;br&gt;&lt;br&gt;{0:Description}" />
      </Items>
    </DetailView>
    <DetailView Id="ProcessDataLockingInfoMergeDialog_DetailView" Caption="警告">
      <Items>
        <StaticText Id="Message" Text="保存しようとしている情報は、別のユーザーに変更されました。変更をマージするか、データを更新して変更点を破棄するか、保存操作をキャンセルしてください。" />
      </Items>
    </DetailView>
    <DetailView Id="ProcessDataLockingInfoRefreshDialog_DetailView" Caption="警告">
      <Items>
        <StaticText Id="Message" Text="保存しようとしている情報は、別のユーザーに変更されました。データを更新して変更点を破棄するか、保存操作をキャンセルしてください。" />
      </Items>
    </DetailView>
  </Views>
