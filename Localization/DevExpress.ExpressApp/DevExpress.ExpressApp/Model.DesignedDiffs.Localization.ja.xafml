<?xml version="1.0" encoding="utf-8"?>
<Application VersionFormat="バージョン {0}.{1}.{2}" ProtectedContentText="保護されたコンテンツ">
  <ActionDesign>
    <Actions>
      <Action Id="CreateModelDifferences" Caption="モデルの差分の作成" ToolTip="すべてのユーザーの設定 (モデルの差分) を初期化します。" />
      <Action Id="CopyModelDifference" Caption="モデルの差分のコピー" ToolTip="一つのユーザーから別のユーザーへ設定 (モデルの差分) をコピーします。ソースの設定 (モデルの差分) を選択し、ボタンをクリックして表示されたポップアップでターゲットを選択します。ユーザーがアプリケーションを再起動すると変更点が反映されます。" />
      <Action Id="ExportModelDifferences" Caption="エクスポート モデルの差分" ToolTip="選択された設定 (モデルの差分) を {0} フォルダーにエクスポートします。" />
      <Action Id="ImportSharedModelDifference" Caption="共有モデルの差分をインポート" ConfirmationMessage="{0} ファイルのコンテンツで共有設定 (モデルの差分) を上書きしようとしています。この操作を実行すると元に戻すことはできません。操作を続行しますか？" ToolTip="アプリケーション フォルダーにある共有設定 (モデルの差分) をインポートします。" />
      <Action Id="ResetModelDifferences" Caption="モデルの差分のリセット" ToolTip="選択された設定 (モデルの差分) をリセットします。変更点は、アプリケーションの再起動後に反映されます。" ConfirmationMessage="選択された設定 (モデルの差分) をリセットしようとしています。操作を続行しますか？" />
      <Action Id="ResetViewSettings" Caption="ビュー設定のリセット" ToolTip="'{0}' ビューのすべての設定をリセットします。" ConfirmationMessage="'{0}' ビューのすべての設定をリセットしようとしています。操作を続行しますか？" />
      <Action Id="MergeAction" Caption="マージ" ShortCaption="マージ" ToolTip="マージ" />
      <Action Id="CancelAction" Caption="キャンセル" ToolTip="キャンセル" ShortCaption="キャンセル" />
      <Action Id="RefreshAction" Caption="更新" ToolTip="更新" ShortCaption="更新" />
      <Action Id="Cancel" Caption="キャンセル" />
      <Action Id="CreateDashboard" Caption="ダッシュボードの作成" />
      <Action Id="Delete" Caption="削除" ConfirmationMessage="選択されたアイテムを削除しようとしています。続行しますか？" />
      <Action Id="Delete Item" Caption="アイテムの削除" ConfirmationMessage="選択されたアイテムを削除しようとしています。続行しますか？" />
      <Action Id="Diagnostic Info" Caption="診断情報" />
      <Action Id="Diagnostic Info.Actions Info">
        <ChoiceActionItems>
          <ChoiceActionItem Id="Actions Info" Caption="操作情報" />
        </ChoiceActionItems>
      </Action>
      <Action Id="Diagnostic Info.View Info">
        <ChoiceActionItems>
          <ChoiceActionItem Id="View Info" Caption="表示情報" />
        </ChoiceActionItems>
      </Action>
      <Action Id="DialogCancel" Caption="キャンセル" />
      <Action Id="DialogClose" Caption="閉じる" ToolTip="閉じる" ShortCaption="閉じる"/>
      <Action Id="FullTextSearch" NullValuePrompt="検索するテキスト..." Caption="テキストでフィルター" ToolTip="テキストでオブジェクトをフィルター" ShortCaption="検索" />
      <Action Id="HideItemsFromDashboard" Caption="ダッシュボードのアイテムを非表示" ToolTip="選択されたアイテムをダッシュボードで非表示" />
      <Action Id="Link" Caption="リンク" />
      <Action Id="ListViewShowObject" Caption="開く" />
      <Action Id="Logoff" Caption="ログオフ" />
      <Action Id="Logon" Caption="ログオン" />
      <Action Id="NavigateBack" ToolTip="前のビューへ移動" Caption="前へ" />
      <Action Id="NavigateForward" ToolTip="次のビューへ移動" Caption="次へ" />
      <Action Id="New" Caption="新規">
        <DisableReasons>
          <Reason Id="MasterObjectIsNew" Caption="新しいオブジェクトが編集されました。" />
        </DisableReasons>
      </Action>
      <Action Id="NextObject" Caption="次のオブジェクト" />
      <Action Id="OrganizeDashboard" Caption="ダッシュボードの整理" />
      <Action Id="DeleteDashboard" Caption="ダッシュボードの削除" />
      <Action Id="PreviousObject" Caption="前のオブジェクト" />
      <Action Id="Refresh" Caption="更新" />
      <Action Id="Save" Caption="保存" />
      <Action Id="SaveAndClose" Caption="保存して閉じる" />
      <Action Id="SaveAndNew" Caption="保存して新規作成" />
      <Action Id="SetFilter" Caption="フィルター" />
      <Action Id="ShowItemsOnDashboard" Caption="ダッシュボードのアイテムを表示" ToolTip="選択されたアイテムをダッシュボードに表示" />
      <Action Id="ShowNavigationItem" Caption="ナビゲーション" />
      <Action Id="Unlink" Caption="リンクの解除" ConfirmationMessage="選択されたレコードのリンクを解除しようとしています。続行しますか？" />
    </Actions>
    <DisableReasons>
      <Reason Id="ByContext_RequireMultipleObjects" Caption="1つ以上のオブジェクトの選択が必要です。" />
      <Reason Id="ByContext_RequireSingleObject" Caption="1つのオブジェクトの選択が必要です。" />
      <Reason Id="Security" Caption="アクセス許可は拒否されました。" />
    </DisableReasons>
  </ActionDesign>
